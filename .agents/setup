#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local label="$1" start=$SECONDS
  shift
  printf '\n==> %s\n' "$label"
  "$@"
  printf '==> %s finished in %ss\n' "$label" "$((SECONDS - start))"
}

# Match the MCP Docker runtime. The orb's newer Node can hang while Playwright
# extracts browser archives; use a known LTS release for Node-based tooling.
node_version=22.22.0
if [[ "$(node --version 2>/dev/null || true)" != "v$node_version" ]]; then
  archive="$(mktemp -d)"
  trap 'rm -rf "$archive"' EXIT
  step "Download Node $node_version" curl -fsSL \
    "https://nodejs.org/dist/v$node_version/node-v$node_version-linux-x64.tar.xz" \
    -o "$archive/node.tar.xz"
  sudo tar -xJf "$archive/node.tar.xz" -C /usr/local --strip-components=1
  rm -rf "$archive"
  trap - EXIT
fi

# Oxlint's JS plugins reserve ~4 GiB of virtual memory per allocator. Small
# no-swap orbs otherwise reject the reservation even though it is not resident.
# https://github.com/oxc-project/oxc/issues/20331
printf 'vm.overcommit_memory = 1\n' | sudo tee /etc/sysctl.d/90-nota-orb.conf >/dev/null
step 'Allow Oxlint virtual-memory reservations' sudo sysctl -p /etc/sysctl.d/90-nota-orb.conf

# Install at the base image's existing PATH location, so later login shells and
# supervised services use the same version without sourcing a setup-only profile.
bun_version="$(node -p "require('./package.json').packageManager.split('@')[1]")"
if [[ "$(bun --version 2>/dev/null || true)" != "$bun_version" ]]; then
  step "Install Bun $bun_version" bash -o pipefail -c \
    'curl -fsSL https://bun.sh/install | BUN_INSTALL=/tmp/nota-bun bash -s -- "bun-v$1"' _ "$bun_version"
  sudo install -m 755 /tmp/nota-bun/bin/bun /usr/local/bin/bun
  rm -rf /tmp/nota-bun
fi

step 'Install locked workspace dependencies' bun install --frozen-lockfile
step 'Build SDK and MCP workspace exports' bun run build:mcp
step 'Install Playwright Chromium' apps/web/node_modules/.bin/playwright install chromium

# Debian 12 Chromium dependencies (playwright install-deps --dry-run chromium),
# plus a local Postgres. Check dpkg so warm setup never refreshes apt needlessly.
packages=(postgresql-15 libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0
  libcairo2 libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3
  libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3
  libxkbcommon0 libxrandr2 xvfb fonts-noto-color-emoji fonts-unifont libfontconfig1
  libfreetype6 xfonts-scalable fonts-liberation fonts-ipafont-gothic fonts-wqy-zenhei
  fonts-tlwg-loma-otf fonts-freefont-ttf)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  step 'Refresh system package index' sudo apt-get update -qq
  step 'Install system prerequisites' sudo env DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends "${missing[@]}"
fi

# Dedicated disposable cluster; never migrate DATABASE_URL from the environment.
# Systemd owns the process so it also starts in orbs restored from the snapshot.
if [[ ! -d /etc/postgresql/15/nota ]]; then
  step 'Initialize local Postgres' sudo pg_createcluster --port 5433 15 nota -- \
    --auth-local=trust --auth-host=trust
fi
sudo pg_conftool 15 nota set listen_addresses localhost
sudo pg_conftool 15 nota set fsync off
sudo pg_conftool 15 nota set synchronous_commit off
step 'Start local Postgres' sudo systemctl enable --now postgresql@15-nota
local_db='postgresql://postgres@127.0.0.1:5433/nota_orb'
if [[ "$(psql -h 127.0.0.1 -p 5433 -U postgres -d postgres -Atc "SELECT 1 FROM pg_database WHERE datname = 'nota_orb'")" != 1 ]]; then
  createdb -h 127.0.0.1 -p 5433 -U postgres nota_orb
fi
step 'Migrate local database' env DATABASE_URL="$local_db" bun run --cwd apps/web db:migrate
if [[ "$(psql "$local_db" -Atc "SELECT 1 FROM users WHERE email = 'admin@nota.app'")" != 1 ]]; then
  step 'Seed local owner' env DATABASE_URL="$local_db" SEED_EMAIL=admin@nota.app SEED_CONFIRM=disposable \
    SEED_NAME=Admin SEED_PASSWORD=changeme bun run --cwd apps/web db:seed
fi

# Preserve any existing configuration; these defaults contain no real credentials.
if [[ ! -f apps/web/.env && ! -f apps/web/.env.local ]]; then
  cat > apps/web/.env <<EOF
# Disposable orb database and development-only session secret.
DATABASE_URL=$local_db
APP_URL=http://localhost:3000
SESSION_SECRET=nota-orb-development-only-session-secret
# Optional analytics; pass development project values into this bootstrap.
NEXT_PUBLIC_POSTHOG_KEY=${NEXT_PUBLIC_POSTHOG_KEY:-}
NEXT_PUBLIC_POSTHOG_HOST=${NEXT_PUBLIC_POSTHOG_HOST:-}
EOF
fi
printf '\nOrb prerequisites ready. External integrations still require development secrets.\n'
