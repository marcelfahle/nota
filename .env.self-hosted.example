# Copy to .env.self-hosted, replace every change-me value, then use:
# docker compose --env-file .env.self-hosted up --build -d
APP_URL=http://localhost:3000
NOTA_PORT=3000
POSTGRES_PASSWORD=change-me-database-password
SESSION_SECRET=change-me-at-least-32-random-characters
CRON_SECRET=change-me-random-cron-secret

DEPLOYMENT_MODE=self-hosted
PAYMENT_MODE=bank-transfer
EMAIL_PROVIDER=log
EMAIL_FROM=Nota <nota@localhost>
STORAGE=local

# EMAIL_PROVIDER=helo
# HELO_API_KEY=
# HELO_CHANNEL_ID=
# EMAIL_PROVIDER=smtp
# SMTP_URL=smtps://user:password@smtp.example.com:465

# STORAGE=s3
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional AI chat. Ordinary invoicing works without it.
# ANTHROPIC_API_KEY=

# Optional MCP profile.
# NOTA_MCP_PUBLIC_URL=http://localhost:3100
# NOTA_OAUTH_SECRET=change-me-32-byte-random-secret
