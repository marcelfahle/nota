{
  "name": "@nota-app/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Nota MCP server for Claude Desktop, Claude Code, Cursor, and other MCP clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelfahle/nota.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/marcelfahle/nota/tree/main/apps/mcp",
  "keywords": [
    "nota",
    "mcp",
    "model-context-protocol",
    "invoicing",
    "claude"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "nota-mcp": "dist/index.js"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./invoice-app-html": {
      "types": "./dist/invoice-app-html.d.ts",
      "import": "./dist/invoice-app-html.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "bun run build && bun run src/index.ts",
    "build": "bun run --cwd ../../packages/sdk build && rm -rf dist && tsc -p tsconfig.json && node scripts/build-ui.mjs && chmod +x dist/index.js",
    "start:http": "node dist/http.js",
    "check": "bun run --cwd ../../packages/sdk build && tsc --noEmit",
    "test": "bun run build && bun test tests",
    "prepublishOnly": "bun run test"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.3.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nota-app/sdk": "workspace:*",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "zod": "^4.3.6"
  }
}
