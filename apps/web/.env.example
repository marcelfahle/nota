# Core app
# Neon or any Postgres (plain Postgres uses node-postgres automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Signs sessions and encrypts OAuth signing keys. BETTER_AUTH_SECRET overrides it.
SESSION_SECRET=replace-with-a-random-32-character-secret
APP_URL=http://localhost:3000

# Remote MCP (ChatGPT, Claude connectors). Defaults to $APP_URL/mcp.
# In production: https://mcp.withnota.com/mcp (that host is served by this app).
# MCP_RESOURCE_URL=https://mcp.example.com/mcp

# Email
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Your Business <billing@example.com>

# Stripe
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# Cron
CRON_SECRET=replace-with-another-random-secret

# Optional seed values
SEED_EMAIL=admin@example.com
SEED_NAME=Admin
SEED_PASSWORD=changeme

# AI
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxx
NOTA_CHAT_MODEL=claude-sonnet-5-5

# Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# Hosted multi-workspace payments. Use direct only for a single-business self-hosted install.
STRIPE_MODE=connect
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxx
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxxxxxxxx
STRIPE_PRICE_MONTHLY=price_xxxxxxxxx
STRIPE_PRICE_YEARLY=price_xxxxxxxxx
