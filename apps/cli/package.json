{
  "name": "@nota-app/cli",
  "version": "0.2.0",
  "private": false,
  "description": "Command-line interface for Nota.",
  "keywords": [
    "billing",
    "cli",
    "invoicing",
    "nota"
  ],
  "homepage": "https://github.com/marcelfahle/nota/tree/main/apps/cli",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcelfahle/nota.git",
    "directory": "apps/cli"
  },
  "bin": {
    "nota": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "preview": "bun run design/index.ts",
    "build:preview": "bun build design/index.ts --target node --splitting --outdir dist/preview",
    "check:preview": "tsc --noEmit -p design/tsconfig.json",
    "dev": "bun run src/index.ts",
    "build": "bun run check && rm -rf dist && bun build src/index.ts --target=node --external @inquirer/prompts --external chalk --external commander --external proper-lockfile --outfile dist/index.js && chmod +x dist/index.js",
    "check": "bun run --cwd ../../packages/sdk build && tsc --noEmit",
    "prepublishOnly": "bun run build && bun run check",
    "test": "bun run --cwd ../../packages/sdk build && bun test tests"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.1",
    "proper-lockfile": "^4.1.2",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@nota-app/sdk": "workspace:*",
    "@types/node": "^25.3.5",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
